# EmailJS — https://www.emailjs.com/
# 1. Créer un compte sur emailjs.com
# 2. Ajouter un service email (Gmail, Outlook…)
# 3. Créer un template avec les variables : {{from_name}}, {{from_email}}, {{subject}}, {{message}}
# 4. Copier ce fichier en .env.local et remplir les valeurs

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
